# Copia este archivo como .env en backend/ (o define las variables en Docker Compose)
BELLESSA_ENVIRONMENT=development
# Neon PostgreSQL (conexión segura): postgresql+psycopg://usuario:clave@host-neon/bellessa?sslmode=require
BELLESSA_DATABASE_URL=sqlite:///./bellessa.db
# En producción con Neon activa las migraciones versionadas de Alembic:
BELLESSA_RUN_MIGRATIONS=false
BELLESSA_JWT_SECRET=cambia-este-secreto-largo-y-aleatorio
BELLESSA_SEED_DEMO=true
BELLESSA_CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180,http://localhost:4180,http://127.0.0.1:4180
BELLESSA_PUBLIC_BASE_URL=http://localhost:5180
BELLESSA_API_PUBLIC_BASE_URL=http://127.0.0.1:8011
BELLESSA_CORS_ORIGIN_REGEX=
BELLESSA_CRON_SECRET=
BELLESSA_PLATFORM_ADMIN_NAME=Felipe Madrid
BELLESSA_PLATFORM_ADMIN_EMAIL=admin@bellessa.mx
# Sin valor por defecto a propósito. Si lo dejas vacío se genera una
# contraseña aleatoria y se muestra una sola vez en el log.
BELLESSA_PLATFORM_ADMIN_PASSWORD=
BELLESSA_WHATSAPP_PROVIDER=mock
BELLESSA_WHATSAPP_TOKEN=
BELLESSA_WHATSAPP_PHONE_NUMBER_ID=
BELLESSA_WHATSAPP_VERIFY_TOKEN=bellessa-verify
BELLESSA_WHATSAPP_APP_SECRET=
BELLESSA_WHATSAPP_BUSINESS_SLUG=salon-lucia
BELLESSA_SCHEDULER_ENABLED=true
