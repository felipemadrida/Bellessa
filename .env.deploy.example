# Copia como .env.deploy (ignorado por git) y completa los valores.
# No subas este archivo con secretos al repositorio.

# Neon (usa la cadena pooled y sslmode=require)
BELLESSA_DATABASE_URL=postgresql+psycopg://USUARIO:PASSWORD@HOST/neondb?sslmode=require

# API
BELLESSA_JWT_SECRET=cambia-por-un-secreto-largo
BELLESSA_SEED_DEMO=true
BELLESSA_CORS_ORIGINS=https://TU-WEB.vercel.app
BELLESSA_PUBLIC_BASE_URL=https://TU-WEB.vercel.app
BELLESSA_API_PUBLIC_BASE_URL=https://TU-API.vercel.app
BELLESSA_CRON_SECRET=cambia-por-un-secreto-de-cron
CRON_SECRET=cambia-por-un-secreto-de-cron
BELLESSA_SCHEDULER_ENABLED=false
BELLESSA_WHATSAPP_PROVIDER=mock
BELLESSA_WHATSAPP_VERIFY_TOKEN=bellessa-verify
BELLESSA_PLATFORM_ADMIN_NAME=Felipe Madrid
BELLESSA_PLATFORM_ADMIN_EMAIL=admin@bellessa.mx
BELLESSA_PLATFORM_ADMIN_PASSWORD=cambia-por-un-secreto-largo

# Web (Vercel build)
VITE_API_URL=https://TU-API.vercel.app/api
