{
  "name": "bellessa-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/audit-design-tokens.mjs && node scripts/audit-dark-coverage.mjs && node scripts/audit-contrast.mjs && node scripts/audit-locales.mjs && node scripts/audit-i18n.mjs && node scripts/audit-spanish-literals.mjs",
    "typecheck": "tsc --noEmit",
    "audit:tokens": "node scripts/audit-design-tokens.mjs",
    "audit:dark": "node scripts/audit-dark-coverage.mjs",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "audit:locales": "node scripts/audit-locales.mjs",
    "audit:i18n": "node scripts/audit-i18n.mjs",
    "audit:spanish": "node scripts/audit-spanish-literals.mjs",
    "preview": "vite preview --port 4180"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.7",
    "i18next": "^27.1.5",
    "i18next-browser-languagedetector": "^8.3.1",
    "i18next-http-backend": "^4.0.10",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^18.0.2",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "vite": "^6.0.5"
  }
}
